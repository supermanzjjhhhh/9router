# Reuse the deployed npm baseline; Dockerfile.npm can recreate that baseline.
# No Next.js rebuild, dependency upgrade, or production data is included.
FROM 9router:0.5.104

ARG VCS_REF
LABEL org.opencontainers.image.version="0.5.104-qoder-context.1" \
      org.opencontainers.image.source="https://github.com/supermanzjjhhhh/9router" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.ref.name="feat/freebuff-provider" \
      io.9router.base-version="0.5.104" \
      io.9router.patch="qoder-context-config-object"

COPY patches/qoder-context-config.cjs /opt/9router-patches/qoder-context-config.cjs
RUN node -e 'if (require("/app/package.json").version !== "0.5.104") throw new Error("Unsupported baseline version")' && \
    node /opt/9router-patches/qoder-context-config.cjs \
      /app/.next-cli-build/server/chunks/5330.js \
      /usr/local/lib/node_modules/9router/app/.next-cli-build/server/chunks/5330.js
