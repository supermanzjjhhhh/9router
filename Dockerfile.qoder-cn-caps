# Qoder CN context-window fix, applied on top of the CURRENT DEPLOYED image.
#
# WHAT THIS BUILDS ON: ghcr.io/supermanzjjhhhh/9router:qoder-context-base-20261021
# is an exact export of the production image 9router:0.5.104-qoder-context.1
# (sha256:e4b004e3328bd64180d98c843a1e44e3ebd96ed04035a915e031d4b1d0a9335b).
# That base already contains the .1 patch (object-shaped `context_config`
# catalogs) in chunks/5330.js. This file never re-applies it and never rebuilds
# Next.js — it only rewrites the capability tables in the shipped bundles, so
# every other production bit (executors, DB, .1 patch, data wiring) is bit-for-bit
# the running image.
#
# WHY A PATCH AND NOT A SOURCE BUILD: production runs the published
# 9router@0.5.104 npm artifact, not a build of this repository. A source build
# would drop the .1 runtime patch and every other deployed delta. The source
# fix in open-sse/providers/capabilities.js ships in a future 9router release;
# this is the interim artifact fix.
#
# SCOPE: CN only. Only the CN gateway is verified on 1M tiers
# (QODER_CONTEXT_TIER=1M, live 200 OK at max_input_tokens:1000000 for dfmodel).
# Intl `qoder` keeps the 200K default.
#
# Layout note: the npm artifact ships capabilities in FOUR chunks per tree
# (server 24/412/8402 + static 5497), and the image carries TWO trees
# (/app and the global npm install). All eight copies are patched; the script
# validates every anchor before writing any file.
# Pin the digest in CI (workflow input); the tag is the human-readable default.
ARG BASE_IMAGE=ghcr.io/supermanzjjhhhh/9router:qoder-context-base-20261021
FROM ${BASE_IMAGE}

ARG VCS_REF
LABEL org.opencontainers.image.version="0.5.104-qoder-cn-caps.2" \
      org.opencontainers.image.source="https://github.com/supermanzjjhhhh/9router" \
      org.opencontainers.image.revision="${VCS_REF}" \
      io.9router.base-version="0.5.104" \
      io.9router.patch="qoder-context-config-object+qoder-cn-caps"

COPY patches/qoder-cn-caps.cjs /opt/9router-patches/qoder-cn-caps.cjs

# 1. Prove the base is the expected artifact AND still carries the .1 patch —
#    if either is missing the whole premise of this image is wrong, so fail.
# 2. Patch all 8 shipped copies.
# 3. Re-parse every patched file, so a bad anchor can never reach a layer.
RUN set -eu; \
    for root in /app /usr/local/lib/node_modules/9router/app; do \
      test "$(node -p "require('$root/package.json').version")" = "0.5.104"; \
      test "$(grep -c 'b=Object.entries(b)' "$root/.next-cli-build/server/chunks/5330.js")" -ge 1; \
    done; \
    node /opt/9router-patches/qoder-cn-caps.cjs \
      /app/.next-cli-build/server/chunks/24.js \
      /app/.next-cli-build/server/chunks/412.js \
      /app/.next-cli-build/server/chunks/8402.js \
      /app/.next-cli-build/static/chunks/5497-d7896a9cac1a7182.js \
      /usr/local/lib/node_modules/9router/app/.next-cli-build/server/chunks/24.js \
      /usr/local/lib/node_modules/9router/app/.next-cli-build/server/chunks/412.js \
      /usr/local/lib/node_modules/9router/app/.next-cli-build/server/chunks/8402.js \
      /usr/local/lib/node_modules/9router/app/.next-cli-build/static/chunks/5497-d7896a9cac1a7182.js; \
    for root in /app /usr/local/lib/node_modules/9router/app; do \
      for f in server/chunks/24.js server/chunks/412.js server/chunks/8402.js \
               static/chunks/5497-d7896a9cac1a7182.js; do \
        node --check "$root/.next-cli-build/$f"; \
        test "$(grep -c '9router-qoder-cn-caps' "$root/.next-cli-build/$f")" = "1"; \
      done; \
    done

# The npm image runs as non-root `node` via su-exec; new files must stay readable.
RUN chown -R node:node /opt/9router-patches 2>/dev/null || true
